{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.aip.computer_chest.lid": {
      "initial_state": "closed",
      "states": {
        "closed": {
          "transitions": [
            {
              "opening": "q.property('aip:open')"
            }
          ]
        },
        "opening": {
          "animations": [
            "open"
          ],
          "transitions": [
            {
              "opened": "q.all_animations_finished"
            },
            {
              "closing": "!q.property('aip:open')"
            }
          ]
        },
        "opened": {
          "animations": [
            "opened"
          ],
          "transitions": [
            {
              "closing": "!q.property('aip:open')"
            }
          ]
        },
        "closing": {
          "animations": [
            "close"
          ],
          "transitions": [
            {
              "closed": "q.all_animations_finished"
            },
            {
              "opening": "q.property('aip:open')"
            }
          ]
        }
      }
    }
  }
}
