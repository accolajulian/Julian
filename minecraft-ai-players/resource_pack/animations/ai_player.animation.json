{
  "format_version": "1.8.0",
  "animations": {
    "animation.aip.ai_player.look": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0.0
          ]
        }
      }
    },
    "animation.aip.ai_player.walk": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            "-math.sin(query.modified_distance_moved * 40.0) * 45.0 * query.modified_move_speed",
            0.0,
            0.0
          ]
        },
        "leftArm": {
          "rotation": [
            "math.sin(query.modified_distance_moved * 40.0) * 45.0 * query.modified_move_speed",
            0.0,
            0.0
          ]
        },
        "rightLeg": {
          "rotation": [
            "math.sin(query.modified_distance_moved * 40.0) * 50.0 * query.modified_move_speed",
            0.0,
            0.0
          ]
        },
        "leftLeg": {
          "rotation": [
            "-math.sin(query.modified_distance_moved * 40.0) * 50.0 * query.modified_move_speed",
            0.0,
            0.0
          ]
        }
      }
    },
    "animation.aip.ai_player.swing": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            "-math.sin(variable.attack_time * 180.0) * 100.0",
            "math.sin(variable.attack_time * 180.0) * 20.0",
            0.0
          ]
        }
      }
    },
    "animation.aip.ai_player.mine": {
      "animation_length": 0.4,
      "bones": {
        "rightArm": {
          "rotation": {
            "0.0": [
              0,
              0,
              0
            ],
            "0.15": [
              -110,
              10,
              0
            ],
            "0.4": [
              0,
              0,
              0
            ]
          }
        }
      }
    },
    "animation.aip.ai_player.crouch": {
      "animation_length": 0.6,
      "bones": {
        "root": {
          "position": [
            0,
            -1.5,
            0
          ]
        },
        "body": {
          "rotation": [
            25,
            0,
            0
          ]
        },
        "rightLeg": {
          "position": [
            0,
            0,
            3
          ]
        },
        "leftLeg": {
          "position": [
            0,
            0,
            3
          ]
        }
      }
    }
  }
}