{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/collect.ts": { "maxDuration": 300, "includeFiles": "public/data/**" },
    "api/areas.ts": { "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/collect", "schedule": "0 11 * * 1" }]
}
