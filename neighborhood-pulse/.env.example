# Copy this file to .env.local for local testing. NEVER commit .env.local.
# On Vercel, add these under Project → Settings → Environment Variables.

# Phase 2: Supabase (database). Supabase → Project Settings → API (and Data API for the URL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # SECRET. Server only. Never put this in a VITE_ variable.

# Phase 2: protects the weekly job URL. Make up a long random password (letters + numbers).
CRON_SECRET=

# Phase 2 (optional): Chicago Data Portal app token. Raises rate limits.
# data.cityofchicago.org → Sign in → Developer Settings → Create New App Token
CHICAGO_APP_TOKEN=

# Phase 3
# ANTHROPIC_API_KEY=
