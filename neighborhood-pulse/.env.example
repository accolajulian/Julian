# Copy this file to .env.local and fill in values. NEVER commit .env.local.
# Phase 1 needs NO keys — the satellite map (Esri World Imagery via MapLibre) is free.

# Phase 2+ (Supabase) — Project Settings → API
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=       # server-only secret, never prefix with VITE_
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=          # safe for the browser (read-only via RLS)

# Phase 2+ (Chicago Data Portal) — optional, raises rate limits
# CHICAGO_APP_TOKEN=

# Phase 2+ (protects the cron endpoint)
# CRON_SECRET=

# Phase 3 (news + AI scoring)
# ANTHROPIC_API_KEY=
# NEWSAPI_KEY=                     # optional; GDELT needs no key
